#!/usr/bin/env bash
set -e

BUILD="build/current"
ROOTFS="$BUILD/initroot"
KOBJ="$BUILD/kernel"

# Kernel verzió lekérése
#KERNEL_VER=$(make -s -C sources/linux-6.6.30 O="$KOBJ" kernelrelease)
KERNEL_VER=6.6.30
MODSRC="$BUILD"
MODDST="$ROOTFS/lib/modules/$KERNEL_VER"

echo ">>> Kernel version: $KERNEL_VER"

if [ $# -eq 0 ]; then
  echo "No module list provided. Use base kernel."
  echo ">>> Creating initramfs..."
  (cd "$ROOTFS" && find . | cpio -o -H newc --quiet) > "$BUILD/init.cpio"
  echo "Initramfs created: $BUILD/init.cpio"
  exit 0
fi

echo ">>> Copying from module lists:"
mkdir -p "$MODDST"

for list in "$@"; do
  echo "  -> $list"
  while read -r mod; do
    [ -z "$mod" ] && continue
    src="$MODSRC/$mod"
    dst="$MODDST/$mod"
    if [ -f "$src" ]; then
      mkdir -p "$(dirname "$dst")"
      cp "$src" "$dst"
      echo "     + $mod"
    else
      echo "     Missing module: $mod"
    fi
  done < "$list"
done

echo ">>> Running depmod..."
depmod -b "$ROOTFS" "$KERNEL_VER"

echo ">>> Creating initramfs..."
(cd "$ROOTFS" && find . | cpio -o -H newc --quiet) > "$BUILD/init.cpio"

echo "Initramfs created: $BUILD/init.cpio"