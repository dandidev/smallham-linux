# Base system: applied on top of 'allnoconfig' (everything else is off).
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_BUSYBOX=y
CONFIG_INSTALL_NO_USR=y
CONFIG_NO_DEBUG_LIB=y
# BusyBox own crypt(): small, no libcrypt needed
CONFIG_USE_BB_CRYPT=y
# init
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_FEATURE_INIT_SCTTY=y
CONFIG_INIT_TERMINAL_TYPE="linux"
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
# shell
CONFIG_SH_IS_ASH=y
CONFIG_SHELL_ASH=y
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_CMDCMD=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_HISTORY=64
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y
# basic commands
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_LN=y
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_TOUCH=y
CONFIG_ECHO=y
CONFIG_SLEEP=y
CONFIG_UNAME=y
CONFIG_CLEAR=y
CONFIG_DMESG=y
CONFIG_PS=y
CONFIG_KILL=y
CONFIG_FREE=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_FEATURE_UMOUNT_ALL=y
CONFIG_MOUNTPOINT=y
