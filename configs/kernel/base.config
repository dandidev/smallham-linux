# Base system: applied on top of 'allnoconfig' (everything else is off).
CONFIG_64BIT=y
CONFIG_EXPERT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_KERNEL_XZ=y
CONFIG_SLUB_TINY=y
CONFIG_PRINTK=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_XZ=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TTY=y
# needed by BusyBox ping and threaded programs
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
# QEMU and VirtualBox CPUs
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y
# load the kernel at 2 MiB instead of 16 MiB: the default needs ~30 MB RAM just to boot
CONFIG_PHYSICAL_START=0x200000
