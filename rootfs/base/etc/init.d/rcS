#!/bin/sh
# System startup: start syslog (if installed), run /etc/init.d/S??* scripts.

# With the disk root fs_init has already moved its devtmpfs here.
# (Not in inittab: BusyBox init runs such lines as 'exec cmd', so '||' would not work.)
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev

# pseudo terminals (only if the kernel has them; no grep in the base image)
case "$(cat /proc/filesystems)" in
    *devpts*) mkdir -p /dev/pts && mount -t devpts devpts /dev/pts ;;
esac

mkdir -p /var/run /var/log /tmp

if command -v syslogd >/dev/null; then
    syslogd -C12 -S
fi

for script in /etc/init.d/S[0-9][0-9]*; do
    [ -x "$script" ] && "$script"
done

echo "System initialization complete"
