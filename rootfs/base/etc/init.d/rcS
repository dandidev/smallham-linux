#!/bin/sh
# System startup: load kernel modules, start syslog, run /etc/init.d/S??* scripts.

mkdir -p /var/run /var/log /tmp

MODDIR="/lib/modules/$(uname -r)"
if [ -d "$MODDIR" ]; then
    for mod in $(find "$MODDIR" -type f -name '*.ko'); do
        name=$(basename "$mod" .ko)
        modprobe "$name" 2>/dev/null || echo "rcS: failed to load module $name"
    done
fi

syslogd -C12 -S

for script in /etc/init.d/S[0-9][0-9]*; do
    [ -x "$script" ] && "$script"
done

echo "System initialization complete"
