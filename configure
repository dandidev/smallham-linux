#!/usr/bin/env bash

set -e

OUT="build/current"
KOBJ="$OUT/kernel"
BBOBJ="$OUT/busybox"
INIT="$OUT/initroot"
ISO="$OUT/iso"

echo "Init folders..."
mkdir -p "$KOBJ" "$BBOBJ" "$INIT" "$ISO"

echo "Recreate current symlink..."
ln -sfn current build/current

echo "Copy initroot fs..."
rsync -a modules/network/initroot/  "$INIT/"

echo "Copy iso fs..."
rsync -a iso/  "$ISO/"

echo "Preparation successful!" 