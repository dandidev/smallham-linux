#!/usr/bin/env bash

set -e

combo="mini"
OUT="build/$combo"
KOBJ="$OUT/kernel"
BBOBJ="$OUT/busybox"
INIT="$OUT/initroot"
ISO="$OUT/iso"

echo "Init folders..."
mkdir -p "$KOBJ" "$BBOBJ" "$INIT" "$ISO"

echo "Recreate current symlink..."
ln -sfn "$combo" build/current

echo "Copy initroot fs..."
rsync -a modules/mini/initroot/  "$INIT/"

echo "Copy iso fs..."
rsync -a iso/  "$ISO/"

echo "Preparation successful!" 