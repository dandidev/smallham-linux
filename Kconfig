mainmenu "SmallHam Configuration"

menu "Module selection"

config HAM
    bool "HAM Radio drivers"

config FS
    bool "Filesystem support"

config OVERLAY_FS
    bool "OverlayFS support"
    depends on FS

config NET
    bool "Network drivers (VirtIO) support"

config USB
    bool "USB support (VirtIO)"

config USB_STORAGE
    bool "USB mass storage (VirtIO) support"
    depends on USB

config SOUND
    bool "Sound drivers support"

endmenu

menu "Extras"

config AX25_TOOLS
    bool "AX.25 Tools (e.g. axctl, kissattach)"
    depends on HAM

    config AX25_TOOLS_NETROMD
        bool "Netorm (netromd)"
        depends on AX25_TOOLS

    config AX25_TOOLS_KISS
        bool "Kiss (kissattach kissparms)"
        depends on AX25_TOOLS
    
    config AX25_DEFAULT_CONFIG
        bool "Generate AX.25 default config (/usr/etc/ax25/axports)"
        depends on AX25_TOOLS

config AX25_APPS
    bool "AX.25 Applications (e.g. listen, beacon)"
    depends on AX25_TOOLS

    config AX25_APPS_CALL
        bool "Call (call)"
        depends on AX25_APPS

    config AX25_APPS_LISTEN
        bool "Listen (listen)"
        depends on AX25_APPS

    config AX25_APPS_IPD
        bool "IP daemon (ax25ipd)"
        depends on AX25_APPS

config DIREWOLF
    bool "Direwolf"
    depends on SOUND
    depends on NET

    config DIREWOLF_DEFAULT_CONFIG
        bool "Generate default config (/etc/direwolf.conf)"
        depends on DIREWOLF

config ALSA_UTILS_APLAY
    bool "aplay"
    depends on SOUND

endmenu
