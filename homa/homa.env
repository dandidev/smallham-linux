# Environment for two Homa test VMs on one network.
# Read by homa/start-vm.sh. Paths are relative to the repository root.
# Everything here is on the host side: the image is the normal Homa image
# (make homa_defconfig && make), the VMs get their IP addresses with DHCP.

# Output files of the Homa image (bzImage, initramfs, disk image)
HOMA_IMAGE=build/out/smallham-homa-x86_64

# Kernel command line of the Homa image (QEMU, virtio disk, serial console),
# the same as 'make run' uses ('make dbg-vars' shows it).
HOMA_CMDLINE="notsc console=ttyS0 squashfs_dev=/dev/vda1 rw_dev=/dev/vda2"

# RAM of each VM in MB (works from 24)
HOMA_MEM=30

# Each VM gets its own copy of the disk image here; your files are kept in it
HOMA_VM_DIR=build/homa-vms

# The network: a bridge on the host with a DHCP server (dnsmasq), see
# "Bridged network (host setup)" in the main README.
HOMA_BRIDGE=virbr0

# MAC address of each VM (must be different on one network)
HOMA_VM1_MAC=52:54:00:00:01:01
HOMA_VM2_MAC=52:54:00:00:01:02
