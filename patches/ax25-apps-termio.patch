+	nterm.c_cflag = CS8 | CREAD | CLOCAL;
+	cfsetispeed(&nterm, baudrate);
+	cfsetospeed(&nterm, baudrate);
 	nterm.c_lflag = 0;
 	nterm.c_cc[VMIN] = 0;
 	nterm.c_cc[VTIME] = 0;
 
-	if (ioctl(ttyfd, TCSETA, &nterm) < 0) {
+	if (tcsetattr(ttyfd, TCSANOW, &nterm) < 0) {
 		perror("setting tty device parameters");
 		exit(1);
 	}
