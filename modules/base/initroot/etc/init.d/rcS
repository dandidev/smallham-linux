#!/bin/sh

mkdir -p /var/log
syslogd -O /var/log/messages
klogd

KVER=$(uname -r)
MODDIR="/lib/modules/$KVER"

find "$MODDIR" -type f -name '*.ko' | \
while read mod; do
    name=$(basename "$mod" .ko)
    echo "  + modprobe $name"
    modprobe "$name" 2>/dev/null || echo "Failed: $name"
done

echo "System initialization complete"
